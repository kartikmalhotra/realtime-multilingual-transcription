# ---------------------------------------------------------------------
# Database. Postgres is used by docker-compose; the SQLite default keeps
# a plain `uvicorn app.main:app` run working with zero setup.
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///./transcriptions.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/transcriptions

# ---------------------------------------------------------------------
# Speech-to-text engine
#   whisper -> self-hosted faster-whisper   (default, open source)
#   browser -> client-side Web Speech API   (no model needed; free-tier demo)
#   gemini  -> Gemini Live API              (needs GEMINI_API_KEY)
# ---------------------------------------------------------------------
STT_ENGINE=whisper

# auto | tiny | base | small | medium | large-v3 | large-v3-turbo
# `auto` = large-v3-turbo on CUDA/Metal, small on CPU-only. Only the large
# models keep Hindi and English in their own scripts, but they need an
# accelerator to run faster than real-time. See docs/ARCHITECTURE.md.
WHISPER_MODEL=auto

# auto | cpu | cuda | mps   (auto probes cuda, then mps, then cpu)
WHISPER_DEVICE=auto
WHISPER_BEAM_SIZE=1

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-live-2.5-flash-preview

# ---------------------------------------------------------------------
# Streaming tuning
# ---------------------------------------------------------------------
PARTIAL_INTERVAL_MS=900
SILENCE_TIMEOUT_MS=800
MAX_UTTERANCE_MS=25000
VAD_ENERGY_THRESHOLD=0.006

CORS_ORIGINS=*
